# Frontend transport. Use "spacetime" only when the published module is the
# intended match backend; use "colyseus" for the authoritative match server.
NEXT_PUBLIC_MATCH_TRANSPORT=colyseus
NEXT_PUBLIC_COLYSEUS_URL=https://match.example.com

# Legacy SpacetimeDB transport, if enabled.
NEXT_PUBLIC_SPACETIME_MODULE_NAME=one-heist-spacetime
NEXT_PUBLIC_SPACETIME_HOST=wss://maincloud.spacetimedb.com

# Optional frontend auth and AI integrations.
NEXT_PUBLIC_SPACETIME_AUTH_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=https://game.example.com
OPENAI_API_KEY=
SMALLEST_API_KEY=
SMALLEST_VOICE_ID=jordan
SMALLEST_TTS_MODEL=lightning_v3.1

# Colyseus process configuration.
HOST=0.0.0.0
PORT=2567
